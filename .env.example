# Flask Configuration
FLASK_SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Training Configuration
TRAINING_INPUT_DIR=data/training/input
TRAINING_GOOD_DIR=data/training/good
TRAINING_BAD_DIR=data/training/bad
TRAINING_SCHEMA_FILE=schema/schema_training.json
TRAINING_LOG_FILE=logs/training_preprocessing.log
TRAINING_SCHEMA_FILENAME=schema_training.json
TRAINING_NUM_COLUMNS=591

# Prediction Configuration
PREDICTION_INPUT_DIR=data/prediction/input
PREDICTION_GOOD_DIR=data/prediction/good
PREDICTION_BAD_DIR=data/prediction/bad
PREDICTION_SCHEMA_FILE=schema/schema_prediction.json
PREDICTION_LOG_FILE=logs/prediction_test.log
PREDICTION_SCHEMA_FILENAME=schema_prediction.json
PREDICTION_NUM_COLUMNS=591
PREDICTION_OUTPUT_DIR=prediction_results

# Model Configuration
MODEL_SAVE_DIR=training_model
KMEANS_CLUSTERER_FILE=kmeans_clusterer.joblib
MODEL_CLUSTER_PREFIX=model_cluster_
MODEL_PREDICTIONS_FILE=model_predictions.csv

# Export Data Configuration
EXPORTED_DATA_DIR=src/exported_data_from_db
TRAINING_EXPORTED_FILE=training_exported_data.csv
PREDICTION_EXPORTED_FILE=prediction_exported_data.csv

# Results Configuration
RESULTS_DIR=prediction_results
UPLOAD_FOLDER=uploads

# Logging Configuration
LOGS_DIR=logs
PREDICTION_TEST_LOG=logs/prediction_test.log
TRAINING_PREPROCESSING_LOG=logs/training_preprocessing.log
PREDICTION_VALIDATION_LOG=logs/prediction_validation.log
PREDICTION_DB_LOG=logs/prediction_db.log
TRAINING_DB_LOG=logs/training_db.log
MAIN_PIPELINE_LOG=logs/main_pipeline.log
WAFER_PREDICTION_DATA_COLUMNS_LOG=logs/wafer_prediction_data_columns.log
WAFER_TRAINING_DATA_COLUMNS_LOG=logs/wafer_training_data_columns.log

# General Configuration
MAIN_LOGS_DIR=logs
MAIN_LOG_FILE=logs/main_pipeline.log
FALLBACK_LOGS_DIR=logs
FALLBACK_LOG_FILE=logs/fallback.log
CSV_EXTENSION=.csv
BASE_DIR=.
SCHEMA_DIR=schema
SCHEMA_LOGS_DIR=logs
SCHEMA_LOG_FILE=logs/schema.log
DB_LOG_FILE=logs/db.log

# BigQuery Configuration (Optional - for cloud database integration)
# BQ_PROJECT=your-gcp-project-id
# BQ_DATASET=your-dataset-name
# BQ_TABLE_TRAINING=training_data
# BQ_TABLE_PREDICTION=prediction_data
# BQ_LOCATION=US
# BQ_SCHEMA_JSON_TRAINING=schema/schema_training.json
# BQ_SCHEMA_JSON_PREDICTION=schema/schema_prediction.json
# BIGQUERY_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Common settings
FILENAME_PATTERN=^wafer_\d{8}_\d{6}\.csv$
MAX_WORKERS=4
